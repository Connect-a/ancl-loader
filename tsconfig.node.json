{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "wxt.config.*",
    "vitest.config.*",
    "eslint.config.*"
  ],
  "compilerOptions": {
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "module": "preserve",
    "moduleResolution": "Bundler",
    "types": ["node"]
  }
}
